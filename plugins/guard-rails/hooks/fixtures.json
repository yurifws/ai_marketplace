[
  {
    "name": "BLOCK: AWS access key in Write content",
    "hook": "check-secrets.mjs",
    "stdin": {
      "tool_name": "Write",
      "tool_input": {
        "file_path": "src/config.js",
        "content": "export const AWS_KEY = \"AKIA2E0ZQX7MRTBK4WPL\";"
      }
    },
    "expectExit": 2,
    "expectStderrContains": "AWS Access Key ID"
  },
  {
    "name": "BLOCK: private key header in Edit new_string",
    "hook": "check-secrets.mjs",
    "stdin": {
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "deploy/key.pem",
        "new_string": "-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA\n-----END RSA PRIVATE KEY-----"
      }
    },
    "expectExit": 2,
    "expectStderrContains": "private key block"
  },
