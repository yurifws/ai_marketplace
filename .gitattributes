# Normalize line endings. Shell scripts MUST stay LF or they fail with
# "$'\r': command not found" when run from git bash on Windows.
* text=auto eol=lf

*.sh   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

*.ps1  text eol=crlf

*.png binary
*.jpg binary
*.gif binary
